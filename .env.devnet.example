# Solana Devnet Configuration for Examples
# Copy to .env.devnet and fill in your values

# Required: Solana RPC URL (devnet)
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

# Optional: Path to a persistent keypair file (reuses the same wallet across runs)
# If not set, a fresh keypair is generated each time
# LOCAL_KEYPAIR_PATH=.devnet-keypair.json

# Optional: Default recipient address for transfer examples
# If not set, a random address is generated
# RECIPIENT_ADDRESS=

# Optional: Anthropic API key (required for claude-agent example)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Telegram bot credentials (required for telegram-approval example)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
