{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": false, // H-36: Disabled to prevent leaking source file paths in published packages
    "sourceMap": false, // H-36: Source maps disabled — they expose original source code and internal file structure. Never enable for production npm publishes.
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true, // SUPPLY-012: Enabled for build perf; run with false periodically to catch dep type errors
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true, // Note: prefix unused params with _ to suppress errors
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "examples"]
}
