# T6-F15 fix: Exclude test ledger keypairs from Docker images.
# These are generated by solana-test-validator and contain private key material
# for the local test validator. They have no value outside local development
# but their presence in container images creates unnecessary attack surface.
test-ledger/

# Development and build artifacts
node_modules/
dist/
.git/
.github/

# Local development files (contain secrets or private key material)
.env
.env.*
.local-keypair.json
.local-recipient.json
.validator.log
.validator.pid

# Security audit reports
security-audits/

# Documentation site build artifacts
docs-site/.vitepress/cache/
docs-site/.vitepress/dist/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
