# kova — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Solana RPC ───────────────────────────────────────────────────────────────
# Required: Solana devnet RPC URL
# Get a free key at https://www.helius.dev or https://www.quicknode.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# ── Wallet ───────────────────────────────────────────────────────────────────
# Optional: Path to a persistent keypair file (reuses the same wallet across runs)
# If not set, a fresh keypair is generated and saved to .devnet-keypair.json
# LOCAL_KEYPAIR_PATH=.devnet-keypair.json

# Optional: Default recipient address for transfer examples
# If not set, a random address is generated each run
# RECIPIENT_ADDRESS=

# ── Claude Agent Example ─────────────────────────────────────────────────────
# Required for: examples/claude-agent
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram Approval Example ────────────────────────────────────────────────
# Required for: examples/telegram-approval
# Create a bot via @BotFather on Telegram, then get your chat ID
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
